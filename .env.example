# Pilot Cohort & Capacity Rules
STUDENT_MONTHLY_TOKEN_GRANT=5
STUDENT_PILOT_YEARS=3,4
ALUMNI_PILOT_COHORT_COUNT=3
CONNECTION_REQUEST_EXPIRY_DAYS=14
